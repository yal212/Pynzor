/* Pynzor dashboard.

   Two bordered panels: a fixed module rail on the left, results on the right,
   with a status line and the equivalent CLI command pinned under them. The
   panel holding focus wears the accent border -- that is the only cue telling
   you where j/k will land. */

Screen {
    layers: base;
}

#target {
    dock: top;
    height: 3;
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
}

#target:focus {
    border: round $accent;
    border-title-color: $accent;
}

#body {
    height: 1fr;
}

/* 36, not 34: a full border eats two columns, and the rail line still has to
   fit a 4-wide glyph, the label, and the 14-wide summary. */
#rail {
    width: 36;
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
    padding: 0 1;
}

#main {
    width: 1fr;
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
    padding: 0 1;
}

#rail:focus-within, #main:focus-within {
    border: round $accent;
    border-title-color: $accent;
}

#modules {
    height: auto;
    max-height: 14;
    background: transparent;
}

#options {
    height: 1fr;
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
    padding: 0 1;
}

.opt-label {
    color: $text-muted;
    padding: 1 0 0 0;
}

/* One rail entry: [x] glyph, label, right-aligned summary. */
.rail-line {
    height: 1;
}

.rail-glyph {
    width: 4;
}

.rail-label {
    width: 1fr;
    padding-left: 1;
}

/* Fixed width, not auto: an auto width changes with the text, which would
   force a layout pass on every progress repaint. 14 fits the longest real
   summary ("640/1024", "12 found", "stopped"). */
.rail-summary {
    width: 14;
    padding-left: 1;
    color: $text-muted;
    text-align: right;
}

ModuleRow.running .rail-glyph {
    color: $warning;
}

ModuleRow.done .rail-glyph {
    color: $success;
}

ModuleRow.failed .rail-glyph {
    color: $error;
}

/* The tab strip doubles as the results panel's heading, so keep it tight. */
#tabs Tab {
    padding: 0 1;
}

ModulePane {
    height: 1fr;
}

.pane-progress {
    height: 1;
    color: $accent;
}

.pane-headline {
    height: 2;
    color: $text-muted;
}

DataTable {
    height: 1fr;
}

#detail-scroll {
    height: 1fr;
}

#detail {
    padding: 1;
}

#statusbar {
    dock: bottom;
    height: 3;
}

#status {
    height: 1;
    color: $text-muted;
    text-overflow: ellipsis;
}

/* The copyable equivalent CLI command -- the thing that teaches the CLI. */
#preview {
    height: 1;
    color: $success;
    background: $panel;
    text-overflow: ellipsis;
}

/* The `?` cheatsheet: a centred card over a dimmed dashboard. */
HelpScreen {
    align: center middle;
    background: $background 60%;
}

#help-card {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    border: round $accent;
    border-title-color: $accent;
    border-subtitle-color: $text-muted;
    background: $surface;
    padding: 1 2;
}

#help-scroll {
    width: auto;
    height: auto;
    max-height: 100%;
}

#help-body {
    width: auto;
    height: auto;
}

.help-column {
    width: auto;
    height: auto;
}

/* Gutter between the two columns; Textual CSS has no sibling selector. */
#help-col-1 {
    padding-left: 3;
}

.help-section {
    width: auto;
    height: auto;
    padding-bottom: 1;
}
